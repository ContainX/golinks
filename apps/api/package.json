{
  "name": "@golinks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GoLinks service: redirect resolver, HTTP API, and web app host.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli.ts migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@golinks/shared": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
