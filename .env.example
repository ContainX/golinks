# GoLinks deployment configuration (spec 06 section 1).
#
# Copy to .env and adjust. Every value below is a working local default for
# `docker compose up -d` plus `pnpm dev`, with test sign-in enabled so that no
# identity provider is needed to develop. Durations accept 30d, 12h, 15m, 90s.
#
# The service validates all of these at startup and exits with a clear message
# on any problem.

# --- Core -------------------------------------------------------------------

# Canonical origin. Drives cookies, OIDC redirect URIs, and the short-host bounce.
# On localhost the session cookie drops its Secure attribute (spec 02 section 3).
BASE_URL=http://localhost:3000

# Hostname members type before the keyword. Informational: it appears in the UI
# and the OpenSearch descriptor, and the bounce works for any non-canonical host.
SHORT_HOST=go

# Interface and port the service listens on.
HOST=0.0.0.0
PORT=3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Data stores ------------------------------------------------------------

# Postgres 16 or newer with the pg_trgm and citext extensions. Points at the
# postgres service in docker-compose.yml.
DATABASE_URL=postgres://golinks:golinks@localhost:5432/golinks

# Optional. When set, sessions and caches move to Redis; required for more than
# one replica. Points at the redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# The container applies pending migrations on startup when this is true, which is
# what the compose full profile does. Keep it off in production and migrate as a
# deploy step instead (spec 09 section 3). Running on the host, apply them yourself:
#   pnpm --filter @golinks/api migrate
MIGRATE_ON_START=true

# --- Sessions ---------------------------------------------------------------

# At least 32 bytes. Signs the session and login cookies. Generate a real one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=development-only-session-secret-change-me

# Absolute session lifetime measured from sign-in.
SESSION_MAX_AGE=30d

# Optional idle expiry. Leave empty to disable.
SESSION_IDLE_TIMEOUT=

# --- Identity provider ------------------------------------------------------
#
# Required unless test sign-in is on. For a real Okta developer org, create an
# OIDC Web Application with the authorization code grant, set its sign-in redirect
# URI to <BASE_URL>/_/auth/callback/<OIDC_ID> and its sign-out redirect URI to
# <BASE_URL>/, fill in the three values below, and set AUTH_TEST_MODE=false.

# Slug this provider gets in its callback URL. Set it to `okta` for an Okta tenant.
OIDC_ID=oidc

# Either the org authorization server (https://acme.okta.com) or a custom one
# (https://acme.okta.com/oauth2/default).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Add `groups` to map identity provider groups to the admin role.
OIDC_SCOPES="openid email profile"

# Button text on the sign-in page.
OIDC_LABEL="Sign in"

# Comma-separated group names whose members become admins.
OIDC_ADMIN_GROUPS=

# JSON array of providers for multi-provider deployments (spec 02 section 1).
# Wins over the single-provider variables above when set.
OIDC_PROVIDERS_JSON=

# Redirect to the provider's end_session_endpoint on sign-out.
OIDC_LOGOUT_AT_IDP=false

# --- Organization resolution ------------------------------------------------

# domain: the organization id is the email domain, with consumer providers mapping
#         to the full address so each personal account is its own organization.
# fixed:  everybody shares ORG_FIXED_ID. Recommended for a single-company tenant.
ORG_RESOLUTION=domain

# Required when ORG_RESOLUTION=fixed.
ORG_FIXED_ID=

# Fold a second domain, or one personal address, into an existing organization.
# Format: a=b,c=d
ORG_DOMAIN_ALIASES=

# Optional allowlist of organization ids. A sign-in that resolves elsewhere is
# rejected with org_not_allowed.
ORG_ALLOWED_IDS=

# Comma-separated emails that receive the admin role at sign-in, so a fresh
# deployment has an admin without editing the database.
INITIAL_ADMIN_EMAILS=owner@widgets.test

# --- Links and resolution ---------------------------------------------------

# How long a transfer link stays valid after it is created.
TRANSFER_TOKEN_TTL=24h

# Trigram similarity floor for the suggestions endpoint, between 0 and 1.
SUGGESTION_MIN_SIMILARITY=0.3

# How long individual visit rows are kept. Counters are never pruned.
VISIT_RETENTION_DAYS=365

# --- Network and limits -----------------------------------------------------

# Honor X-Forwarded-Proto, X-Forwarded-Host, and X-Forwarded-For from the
# immediate proxy. Leave false when nothing sits in front of the service.
TRUST_PROXY=false

# Rate limits (spec 05 section 5), counted per session on the API and per IP
# address on the resolver, over one RATE_LIMIT_WINDOW.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_API=600
RATE_LIMIT_LINK_CREATE=60
RATE_LIMIT_RESOLVER=1200

# Prometheus metrics on /_/metrics. Restrict the endpoint at the network layer
# when it is enabled (spec 07 section 3).
METRICS_ENABLED=false

# Scheduled background jobs: visit retention (spec 07 section 2.3) and the
# expired-session sweep (spec 02 section 3). Every replica may leave this on:
# a Postgres advisory lock keeps one job to one replica at a time (spec 09
# section 1). Turn it off for a replica that should serve traffic only.
JOBS_ENABLED=true

# Optional. Directory of built web app assets the service serves in production.
# Defaults to the sibling apps/web/dist, so leave it empty unless the assets are
# mounted somewhere else.
WEB_DIST_PATH=

# --- Test sign-in -----------------------------------------------------------
#
# For automated tests and local development only. The service refuses to start
# when this is on and NODE_ENV=production (spec 02 section 8).

AUTH_TEST_MODE=true

# HS256 key for the short-lived tokens POST /_/auth/test-login accepts.
AUTH_TEST_SECRET=development-only-test-sign-in-secret

# Only emails in these domains may sign in through test mode. The two fixture
# organizations used throughout the test suites (spec 10 section 2).
AUTH_TEST_DOMAINS=widgets.test,gizmos.test

# --- Integration tests ------------------------------------------------------

# Optional. When set, the API integration harness uses this database instead of
# starting an embedded Postgres. Point it at a disposable database: the harness
# truncates every table between tests. The compose init script creates
# golinks_test for exactly this purpose.
# GOLINKS_TEST_DATABASE_URL=postgres://golinks:golinks@localhost:5432/golinks_test
